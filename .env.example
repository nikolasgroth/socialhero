# ─── Database ───
# Produktion: Starke Passwörter verwenden, Managed DB (Supabase, RDS, etc.)
DATABASE_URL=postgresql+asyncpg://socialhero:socialhero@localhost:5432/socialhero
REDIS_URL=redis://localhost:6379/0

# ─── Security (PFLICHT in Produktion) ───
# JWT_SECRET: Generieren mit: openssl rand -hex 32
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple Sign In ───
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ─── Firebase Cloud Messaging (Push Notifications) ───
# Für Push-Benachrichtigungen: Firebase Console → Projekt → Service Accounts → Key erstellen
# JSON-Inhalt als einzeilige Zeichenkette (Escaping beachten)
FCM_CREDENTIALS_JSON=

# ─── App Configuration ───
ALERT_RADIUS_KM=1.0
ALERT_COUNTDOWN_SEC=5
ACCEPT_TIMEOUT_SEC=30

# ─── CORS ───
# Produktion: Deine Frontend-Domain(s) hinzufügen, z.B.:
# CORS_ORIGINS=https://app.socialhero.de,https://www.socialhero.de
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Environment ───
ENVIRONMENT=development
DEBUG=true
